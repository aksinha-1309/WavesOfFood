<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="24dp">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Live Order Tracking"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Step 1: Order Placed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivStep1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/right" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Order Placed Successfully"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/line1"
        android:layout_width="3dp"
        android:layout_height="40dp"
        android:layout_marginStart="14dp"
        android:background="#4CAF50" />

    <!-- Step 2: Preparing / Accepted -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivStep2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/truck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Chef is Preparing Your Food"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/line2"
        android:layout_width="3dp"
        android:layout_height="40dp"
        android:layout_marginStart="14dp"
        android:background="#CCCCCC" />

    <!-- Step 3: Out for Delivery -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivStep3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/truck" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Out for Delivery"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/line3"
        android:layout_width="3dp"
        android:layout_height="40dp"
        android:layout_marginStart="14dp"
        android:background="#CCCCCC" />

    <!-- Step 4: Delivered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivStep4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/right" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Delivered to your Doorstep"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>